# ---- Unity generated (never commit) ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# NOTE: never ignore *.meta. A missing .meta causes GUID churn and broken references.

# ---- IDE / autogenerated project files ----
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
/.vsconfig

# ---- Build artifacts ----
*.apk
*.aab
*.ipa
*.app
*.unitypackage
*.unitypackage.meta
ExportedObj/
crashlytics-build.properties
sysinfo.txt

# ---- Addressables (future-proofing) ----
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- Slap Mania local-only ----
/Docs/_local/
/Tools/local/
*.slapdump.json

# ---- Claude Code: commit settings.json, never the local override (keeps secrets out of git) ----
/.claude/settings.local.json

# ---- Local captures (screenshots / raw profiler data stay off git - see Docs/Perf/BASELINE.md) ----
/[Cc]aptures/
/[Pp]rofiler[Cc]aptures/

# ---- Python bytecode ----
__pycache__/
*.py[cod]

# Signing keys never go to the repo (the Android keystore lives in KeyStore/ locally)
KeyStore/
*.keystore
*.jks

# Unity build-tool cache and crash-recovery scenes
.utmp/
Assets/_Recovery/
Assets/_Recovery.meta
